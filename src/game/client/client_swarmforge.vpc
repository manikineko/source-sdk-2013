$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"swarmforge" [!$SOURCESDK]
$Macro GAMENAME 	"mod_swarmforge" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"$BASE;swarmforge\ui,.\swarmforge,$SRCDIR\game\shared\swarmforge,.\hl2,.\hl2\elements,$SRCDIR\game\shared\hl2"
		$PreprocessorDefinitions			"$BASE;SWARMFORGE;HL2_CLIENT_DLL;NEXT_BOT"
	}
}

